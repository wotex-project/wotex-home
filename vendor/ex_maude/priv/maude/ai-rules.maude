*** AI Rules Conflict Detection Module
***
*** Companion to iot-rules.maude. Where iot-rules.maude verifies IoT
*** automation rules over W3C-WoT Things, Properties, and Actions, this
*** module verifies AI-generated rules over Agents, Capabilities,
*** ToolInvocations, and Predicates. Detects seven conflict types
*** including: tool-call conflict, capability shadowing, pack-tool
*** composition mismatch, sovereignty violation, authority escalation,
*** approval-gate bypass, and agent-loop cascade.

*** ============================================================
*** AGENT-ID: tenant-scoped agent identifier
*** ============================================================

fmod AGENT-ID is
  protecting STRING .

  sort TenantId .
  sort AgentId .

  op tenant : String -> TenantId [ctor] .
  op agent : TenantId String -> AgentId [ctor] .

  op eqTenantId : TenantId TenantId -> Bool .
  eq eqTenantId(tenant(S1:String), tenant(S2:String)) = S1:String == S2:String .

  op eqAgentId : AgentId AgentId -> Bool .
  eq eqAgentId(agent(T1:TenantId, S1:String), agent(T2:TenantId, S2:String)) =
    eqTenantId(T1:TenantId, T2:TenantId) and S1:String == S2:String .

  op tenantOf : AgentId -> TenantId .
  eq tenantOf(agent(T:TenantId, S:String)) = T:TenantId .
endfm

*** ============================================================
*** JURISDICTION: closed enumeration with sub-jurisdictions
*** ============================================================

fmod JURISDICTION is
  sort Jurisdiction .
  sort SubJurisdiction .
  subsort SubJurisdiction < Jurisdiction .

  *** Top-level jurisdictions
  ops eu us cn ch uk ca au other : -> Jurisdiction [ctor] .

  *** EU sub-jurisdictions (extend as needed)
  ops de fr es it nl se fi dk pl be ie pt at : -> SubJurisdiction [ctor] .

  *** Parent-of relation for sub-jurisdiction inheritance
  op parentOf : SubJurisdiction -> Jurisdiction .
  eq parentOf(de) = eu .
  eq parentOf(fr) = eu .
  eq parentOf(es) = eu .
  eq parentOf(it) = eu .
  eq parentOf(nl) = eu .
  eq parentOf(se) = eu .
  eq parentOf(fi) = eu .
  eq parentOf(dk) = eu .
  eq parentOf(pl) = eu .
  eq parentOf(be) = eu .
  eq parentOf(ie) = eu .
  eq parentOf(pt) = eu .
  eq parentOf(at) = eu .

  *** Equality
  op eqJurisdiction : Jurisdiction Jurisdiction -> Bool .
  eq eqJurisdiction(J:Jurisdiction, J:Jurisdiction) = true .
  eq eqJurisdiction(J1:Jurisdiction, J2:Jurisdiction) = false [owise] .

  *** A jurisdiction set with closed-set membership semantics
  sort JurisdictionSet .
  subsort Jurisdiction < JurisdictionSet .
  op noJurisdiction : -> JurisdictionSet [ctor] .
  op _;;_ : JurisdictionSet JurisdictionSet -> JurisdictionSet [ctor assoc comm id: noJurisdiction] .

  op inJurisdictionSet : Jurisdiction JurisdictionSet -> Bool .
  eq inJurisdictionSet(J:Jurisdiction, noJurisdiction) = false .
  eq inJurisdictionSet(J:Jurisdiction, J:Jurisdiction) = true .
  eq inJurisdictionSet(J:Jurisdiction, J:Jurisdiction ;; JS:JurisdictionSet) = true .
  eq inJurisdictionSet(SJ:SubJurisdiction, J:Jurisdiction ;; JS:JurisdictionSet) =
    eqJurisdiction(parentOf(SJ:SubJurisdiction), J:Jurisdiction) or
    inJurisdictionSet(SJ:SubJurisdiction, JS:JurisdictionSet) .
  eq inJurisdictionSet(J1:Jurisdiction, J2:Jurisdiction ;; JS:JurisdictionSet) =
    eqJurisdiction(J1:Jurisdiction, J2:Jurisdiction) or inJurisdictionSet(J1:Jurisdiction, JS:JurisdictionSet) .
  eq inJurisdictionSet(J:Jurisdiction, JS:JurisdictionSet) = false [owise] .
endfm

*** ============================================================
*** PREDICATE-VALUE: extends iot-rules' PROPERTY-VALUE with
*** intervalVal (for budget reasoning) and jurisdictionVal (for
*** sovereignty)
*** ============================================================

fmod PREDICATE-VALUE is
  protecting STRING .
  protecting BOOL .
  protecting NAT .
  protecting JURISDICTION .

  sort PredicateValue .

  *** Wrapped scalar values (string-encoded numerics avoid sort
  *** conflicts and parallel iot-rules.maude's design)
  op strVal : String -> PredicateValue [ctor] .
  op intVal : String -> PredicateValue [ctor] .
  op boolVal : Bool -> PredicateValue [ctor] .

  *** Numeric interval representation for budget arithmetic
  op intervalVal : Nat Nat -> PredicateValue [ctor] .

  *** Jurisdiction wrap for sovereignty predicates
  op jurisdictionVal : Jurisdiction -> PredicateValue [ctor] .

  *** Null sentinel
  op null : -> PredicateValue [ctor] .

  *** Equality
  op eqPredValue : PredicateValue PredicateValue -> Bool .
  eq eqPredValue(strVal(S1:String), strVal(S2:String)) = S1:String == S2:String .
  eq eqPredValue(intVal(S1:String), intVal(S2:String)) = S1:String == S2:String .
  eq eqPredValue(boolVal(B1:Bool), boolVal(B2:Bool)) = B1:Bool == B2:Bool .
  eq eqPredValue(intervalVal(L1:Nat, U1:Nat), intervalVal(L2:Nat, U2:Nat)) =
    L1:Nat == L2:Nat and U1:Nat == U2:Nat .
  eq eqPredValue(jurisdictionVal(J1:Jurisdiction), jurisdictionVal(J2:Jurisdiction)) =
    eqJurisdiction(J1:Jurisdiction, J2:Jurisdiction) .
  eq eqPredValue(null, null) = true .
  eq eqPredValue(V1:PredicateValue, V2:PredicateValue) = false [owise] .

  *** Interval arithmetic helpers
  *** intervalAdd: [a,b] + [c,d] = [a+c, b+d]
  op intervalAdd : PredicateValue PredicateValue -> PredicateValue .
  eq intervalAdd(intervalVal(L1:Nat, U1:Nat), intervalVal(L2:Nat, U2:Nat)) =
    intervalVal(L1:Nat + L2:Nat, U1:Nat + U2:Nat) .
  eq intervalAdd(V1:PredicateValue, V2:PredicateValue) = null [owise] .

  *** intervalGt: strict greater under all valuations: lower(a) > upper(b)
  op intervalGt : PredicateValue PredicateValue -> Bool .
  eq intervalGt(intervalVal(L1:Nat, U1:Nat), intervalVal(L2:Nat, U2:Nat)) =
    L1:Nat > U2:Nat .
  eq intervalGt(V1:PredicateValue, V2:PredicateValue) = false [owise] .

  *** intervalLte: every valuation of a is <= every valuation of b
  op intervalLte : PredicateValue PredicateValue -> Bool .
  eq intervalLte(intervalVal(L1:Nat, U1:Nat), intervalVal(L2:Nat, U2:Nat)) =
    U1:Nat <= L2:Nat .
  eq intervalLte(V1:PredicateValue, V2:PredicateValue) = false [owise] .
endfm

*** ============================================================
*** CAPABILITY: named ability with optional type-shape signature
*** ============================================================

fmod CAPABILITY is
  protecting STRING .

  sort Capability .
  sort CapabilitySet .
  subsort Capability < CapabilitySet .

  op cap : String String -> Capability [ctor] .
    *** cap(name, type_shape_hash) — shape hash distinguishes
    *** capabilities offered with different return types

  op noCap : -> CapabilitySet [ctor] .
  op _||_ : CapabilitySet CapabilitySet -> CapabilitySet [ctor assoc comm id: noCap] .

  op capName : Capability -> String .
  eq capName(cap(N:String, S:String)) = N:String .

  op capShape : Capability -> String .
  eq capShape(cap(N:String, S:String)) = S:String .

  op eqCapName : Capability Capability -> Bool .
  eq eqCapName(cap(N1:String, S1:String), cap(N2:String, S2:String)) = N1:String == N2:String .

  op eqCapShape : Capability Capability -> Bool .
  eq eqCapShape(cap(N1:String, S1:String), cap(N2:String, S2:String)) = S1:String == S2:String .

  op containsCap : String CapabilitySet -> Bool .
  eq containsCap(N:String, noCap) = false .
  eq containsCap(N:String, cap(N:String, S:String) || CS:CapabilitySet) = true .
  eq containsCap(N:String, cap(M:String, S:String) || CS:CapabilitySet) =
    containsCap(N:String, CS:CapabilitySet) [owise] .
endfm

*** ============================================================
*** TOOL-INVOCATION: tool name + structured argument map +
*** required capability
*** ============================================================

fmod TOOL-INVOCATION is
  protecting STRING .
  protecting CAPABILITY .
  protecting PREDICATE-VALUE .
  protecting JURISDICTION .
  protecting AGENT-ID .

  sort ToolName .
  sort ArgEntry .
  sort ArgMap .
  sort ToolInvocation .
  sort ToolInvocationList .

  op tool : String -> ToolName [ctor] .

  *** Argument map: an associative-commutative bag of key:value entries
  op _:_ : String PredicateValue -> ArgEntry [ctor] .
  subsort ArgEntry < ArgMap .
  op argMap : -> ArgMap [ctor] .
  op _andArg_ : ArgMap ArgMap -> ArgMap [ctor assoc comm id: argMap] .

  *** Tool invocation: tool name, args, required capability, optional
  *** sovereignty-bearing route, and optional approval class
  op invokeTool : ToolName ArgMap String Jurisdiction -> ToolInvocation [ctor] .
  op requireApproval : String -> ToolInvocation [ctor] .

  *** Invocation list (ordered)
  op nilInvocation : -> ToolInvocationList [ctor] .
  subsort ToolInvocation < ToolInvocationList .
  op _>>_ : ToolInvocationList ToolInvocationList -> ToolInvocationList [ctor assoc id: nilInvocation] .

  op toolNameOf : ToolInvocation -> ToolName .
  eq toolNameOf(invokeTool(N:ToolName, A:ArgMap, C:String, J:Jurisdiction)) = N:ToolName .

  op argsOf : ToolInvocation -> ArgMap .
  eq argsOf(invokeTool(N:ToolName, A:ArgMap, C:String, J:Jurisdiction)) = A:ArgMap .

  op capRequired : ToolInvocation -> String .
  eq capRequired(invokeTool(N:ToolName, A:ArgMap, C:String, J:Jurisdiction)) = C:String .

  op invocationJurisdiction : ToolInvocation -> Jurisdiction .
  eq invocationJurisdiction(invokeTool(N:ToolName, A:ArgMap, C:String, J:Jurisdiction)) = J:Jurisdiction .

  op eqToolName : ToolName ToolName -> Bool .
  eq eqToolName(tool(S1:String), tool(S2:String)) = S1:String == S2:String .

  *** isApproval: distinguishes approval-gate invocations from regular
  op isApproval : ToolInvocation -> Bool .
  eq isApproval(requireApproval(C:String)) = true .
  eq isApproval(I:ToolInvocation) = false [owise] .

  op approvalClass : ToolInvocation -> String .
  eq approvalClass(requireApproval(C:String)) = C:String .
  eq approvalClass(I:ToolInvocation) = "" [owise] .

  *** listContainsApproval: does the list pass through any approval gate
  *** Two-equation form (base + recursive) — assoc-id automatically
  *** decomposes single-element lists as `I >> nilInvocation`, so a
  *** dedicated single-element clause would compete with the
  *** recursive case and risk non-termination under Maude's
  *** assoc-id matching.
  op listContainsApproval : ToolInvocationList -> Bool .
  eq listContainsApproval(nilInvocation) = false .
  eq listContainsApproval(I:ToolInvocation >> IL:ToolInvocationList) =
    isApproval(I:ToolInvocation) or listContainsApproval(IL:ToolInvocationList) .
endfm

*** ============================================================
*** PREDICATE: extends iot-rules' CONDITION with capability,
*** budget, latency, jurisdiction, authority predicates
*** ============================================================

fmod PREDICATE is
  protecting CAPABILITY .
  protecting PREDICATE-VALUE .
  protecting AGENT-ID .
  protecting JURISDICTION .

  sort Predicate .

  *** Property-style predicates (carry over from iot-rules)
  op propEq : String PredicateValue -> Predicate [ctor] .
  op propGt : String PredicateValue -> Predicate [ctor] .
  op propLt : String PredicateValue -> Predicate [ctor] .
  op propGte : String PredicateValue -> Predicate [ctor] .
  op propLte : String PredicateValue -> Predicate [ctor] .

  *** Capability predicates
  op capabilityRequired : String -> Predicate [ctor] .
  op capabilityGranted : String -> Predicate [ctor] .

  *** Budget predicates (interval-typed values)
  op budgetWithin : String PredicateValue -> Predicate [ctor] .
    *** budgetWithin(scope, intervalVal(lo, hi)) — accumulated cost
    *** under bounded simulation must stay in interval

  *** Authority predicates (Nat-typed authority levels)
  op authorityAtLeast : Nat -> Predicate [ctor] .
  op authorityRequired : Nat -> Predicate [ctor] .

  *** Jurisdiction predicates
  op jurisdictionAllowed : Jurisdiction -> Predicate [ctor] .
  op jurisdictionForbidden : Jurisdiction -> Predicate [ctor] .

  *** Latency predicate (Nat ms)
  op latencyAtMost : Nat -> Predicate [ctor] .

  *** Logical operators (carry over from iot-rules)
  op andP : Predicate Predicate -> Predicate [ctor assoc comm] .
  op orP : Predicate Predicate -> Predicate [ctor assoc comm] .
  op notP : Predicate -> Predicate [ctor] .
  op alwaysP : -> Predicate [ctor] .

  *** Predicate name extraction (for cross-cutting analyses)
  op predicateProperty : Predicate -> String .
  eq predicateProperty(propEq(P:String, V:PredicateValue)) = P:String .
  eq predicateProperty(propGt(P:String, V:PredicateValue)) = P:String .
  eq predicateProperty(propLt(P:String, V:PredicateValue)) = P:String .
  eq predicateProperty(propGte(P:String, V:PredicateValue)) = P:String .
  eq predicateProperty(propLte(P:String, V:PredicateValue)) = P:String .
  eq predicateProperty(capabilityRequired(C:String)) = C:String .
  eq predicateProperty(capabilityGranted(C:String)) = C:String .
  eq predicateProperty(P:Predicate) = "" [owise] .

  op predicateValue : Predicate -> PredicateValue .
  eq predicateValue(propEq(P:String, V:PredicateValue)) = V:PredicateValue .
  eq predicateValue(propGt(P:String, V:PredicateValue)) = V:PredicateValue .
  eq predicateValue(propLt(P:String, V:PredicateValue)) = V:PredicateValue .
  eq predicateValue(P:Predicate) = null [owise] .
  *** A possible dependency edge exists for any positive capability reference.
  op requiresGrantedCapability : Predicate CapabilitySet -> Bool .
  eq requiresGrantedCapability(capabilityRequired(C:String), CS:CapabilitySet) = containsCap(C:String, CS:CapabilitySet) .
  eq requiresGrantedCapability(andP(P1:Predicate, P2:Predicate), CS:CapabilitySet) =
    requiresGrantedCapability(P1:Predicate, CS:CapabilitySet) or requiresGrantedCapability(P2:Predicate, CS:CapabilitySet) .
  eq requiresGrantedCapability(orP(P1:Predicate, P2:Predicate), CS:CapabilitySet) =
    requiresGrantedCapability(P1:Predicate, CS:CapabilitySet) or requiresGrantedCapability(P2:Predicate, CS:CapabilitySet) .
  eq requiresGrantedCapability(P:Predicate, CS:CapabilitySet) = false [owise] .
endfm

*** ============================================================
*** AI-RULE: extends iot-rules' Rule with capability_grants,
*** authority_required, tenant_scope
*** ============================================================

fmod AI-RULE is
  protecting PREDICATE .
  protecting TOOL-INVOCATION .
  protecting CAPABILITY .

  sort AIRule .
  sort RuleSet .
  subsort AIRule < RuleSet .

  *** AI rule constructor:
  *** aiRule(id, agent, trigger, invocations, cap_grants, authority_req, priority)
  op aiRule : String AgentId Predicate ToolInvocationList CapabilitySet Nat Nat -> AIRule [ctor] .

  *** Rule-set composition (carry-over from iot-rules)
  op emptyRules : -> RuleSet [ctor] .
  op _;_ : RuleSet RuleSet -> RuleSet [ctor assoc comm id: emptyRules] .

  op ruleId : AIRule -> String .
  eq ruleId(aiRule(I:String, A:AgentId, T:Predicate, IL:ToolInvocationList, CG:CapabilitySet, AR:Nat, P:Nat)) = I:String .

  op ruleAgent : AIRule -> AgentId .
  eq ruleAgent(aiRule(I:String, A:AgentId, T:Predicate, IL:ToolInvocationList, CG:CapabilitySet, AR:Nat, P:Nat)) = A:AgentId .

  op ruleTrigger : AIRule -> Predicate .
  eq ruleTrigger(aiRule(I:String, A:AgentId, T:Predicate, IL:ToolInvocationList, CG:CapabilitySet, AR:Nat, P:Nat)) = T:Predicate .

  op ruleInvocations : AIRule -> ToolInvocationList .
  eq ruleInvocations(aiRule(I:String, A:AgentId, T:Predicate, IL:ToolInvocationList, CG:CapabilitySet, AR:Nat, P:Nat)) = IL:ToolInvocationList .

  op ruleCapabilityGrants : AIRule -> CapabilitySet .
  eq ruleCapabilityGrants(aiRule(I:String, A:AgentId, T:Predicate, IL:ToolInvocationList, CG:CapabilitySet, AR:Nat, P:Nat)) = CG:CapabilitySet .

  op ruleAuthorityRequired : AIRule -> Nat .
  eq ruleAuthorityRequired(aiRule(I:String, A:AgentId, T:Predicate, IL:ToolInvocationList, CG:CapabilitySet, AR:Nat, P:Nat)) = AR:Nat .

  op rulePriority : AIRule -> Nat .
  eq rulePriority(aiRule(I:String, A:AgentId, T:Predicate, IL:ToolInvocationList, CG:CapabilitySet, AR:Nat, P:Nat)) = P:Nat .
endfm

*** ============================================================
*** AI-CONFLICT: seven conflict types
*** ============================================================

fmod AI-CONFLICT is
  protecting AI-RULE .

  sort AIConflictType .
  sort AIConflict .
  sort AIConflictSet .
  subsort AIConflict < AIConflictSet .

  *** Supported conflict types
  ops toolCallConflict
      capabilityShadowing
      packToolCompositionMismatch
      sovereigntyViolation
      authorityEscalation
      approvalGateBypass
      agentLoopCascade : -> AIConflictType [ctor] .

  *** Pairwise-conflict constructor (R1 and R2 conflict)
  op aiConflict : AIConflictType AIRule AIRule String -> AIConflict [ctor] .

  *** Single-rule-conflict constructor (a rule violates a global
  *** constraint independent of other rules)
  op aiConflictSingle : AIConflictType AIRule String -> AIConflict [ctor] .

  op noAIConflict : -> AIConflictSet [ctor] .
  op _||c||_ : AIConflictSet AIConflictSet -> AIConflictSet [ctor assoc comm id: noAIConflict] .

  op conflictType : AIConflict -> AIConflictType .
  eq conflictType(aiConflict(T:AIConflictType, R1:AIRule, R2:AIRule, S:String)) = T:AIConflictType .
  eq conflictType(aiConflictSingle(T:AIConflictType, R:AIRule, S:String)) = T:AIConflictType .

  op conflictReason : AIConflict -> String .
  eq conflictReason(aiConflict(T:AIConflictType, R1:AIRule, R2:AIRule, S:String)) = S:String .
  eq conflictReason(aiConflictSingle(T:AIConflictType, R:AIRule, S:String)) = S:String .
endfm

*** ============================================================
*** TOOL-CONFLICT-DETECTOR: conflict #1 (tool-call conflict)
***
*** Two rules invoke the same tool with conflicting required
*** arguments under the same agent — the same conflict shape as
*** iot-rules' state-conflict, lifted to tool invocations with
*** structured argument maps.
*** ============================================================

fmod TOOL-CONFLICT-DETECTOR is
  protecting AI-CONFLICT .

  *** Two arg entries conflict if same key, different values
  op argEntriesConflict : ArgEntry ArgEntry -> Bool .
  eq argEntriesConflict(K1:String : V1:PredicateValue, K2:String : V2:PredicateValue) =
    K1:String == K2:String and not eqPredValue(V1:PredicateValue, V2:PredicateValue) .

  *** Does an arg entry conflict with any in a map?
  op entryConflictsWithMap : ArgEntry ArgMap -> Bool .
  eq entryConflictsWithMap(E:ArgEntry, argMap) = false .
  eq entryConflictsWithMap(E:ArgEntry, E2:ArgEntry andArg AM:ArgMap) =
    argEntriesConflict(E:ArgEntry, E2:ArgEntry) or entryConflictsWithMap(E:ArgEntry, AM:ArgMap) .

  *** Do two arg maps have any conflicting pinned arguments?
  op argMapsConflict : ArgMap ArgMap -> Bool .
  eq argMapsConflict(argMap, AM:ArgMap) = false .
  eq argMapsConflict(E:ArgEntry andArg AM1:ArgMap, AM2:ArgMap) =
    entryConflictsWithMap(E:ArgEntry, AM2:ArgMap) or argMapsConflict(AM1:ArgMap, AM2:ArgMap) .

  *** Do two single invocations conflict (same tool, conflicting args)?
  *** Helper that operates on a single ToolInvocation pair only —
  *** keeps the list-iteration recursion clean under assoc-id.
  op invocationsConflict : ToolInvocation ToolInvocation -> Bool .
  eq invocationsConflict(invokeTool(N1:ToolName, A1:ArgMap, C1:String, J1:Jurisdiction),
                         invokeTool(N2:ToolName, A2:ArgMap, C2:String, J2:Jurisdiction)) =
    eqToolName(N1:ToolName, N2:ToolName) and argMapsConflict(A1:ArgMap, A2:ArgMap) .
  eq invocationsConflict(I1:ToolInvocation, I2:ToolInvocation) = false [owise] .

  *** Does a single invocation conflict with any in a list?
  op invocationVsList : ToolInvocation ToolInvocationList -> Bool .
  eq invocationVsList(I:ToolInvocation, nilInvocation) = false .
  eq invocationVsList(I1:ToolInvocation, I2:ToolInvocation >> IL:ToolInvocationList) =
    invocationsConflict(I1:ToolInvocation, I2:ToolInvocation)
    or invocationVsList(I1:ToolInvocation, IL:ToolInvocationList) .

  *** Do two invocation lists have any conflicting pair?
  op invocationListsConflict : ToolInvocationList ToolInvocationList -> Bool .
  eq invocationListsConflict(nilInvocation, IL:ToolInvocationList) = false .
  eq invocationListsConflict(I:ToolInvocation >> IL1:ToolInvocationList, IL2:ToolInvocationList) =
    invocationVsList(I:ToolInvocation, IL2:ToolInvocationList)
    or invocationListsConflict(IL1:ToolInvocationList, IL2:ToolInvocationList) .

  op detectToolCallConflict : AIRule AIRule -> AIConflictSet .
  eq detectToolCallConflict(R1:AIRule, R2:AIRule) =
    if eqAgentId(ruleAgent(R1:AIRule), ruleAgent(R2:AIRule)) and
       invocationListsConflict(ruleInvocations(R1:AIRule), ruleInvocations(R2:AIRule))
    then aiConflict(toolCallConflict, R1:AIRule, R2:AIRule, "Same agent, same tool, conflicting required arguments")
    else noAIConflict
    fi .
endfm

*** ============================================================
*** CAPABILITY-CONFLICT-DETECTOR: conflicts #2 and #3
***
*** #2 capability shadowing: two rules grant the same capability
*** name within the same tenant — the rule precedence (priority)
*** must unambiguously resolve. If two rules grant the same
*** capability with the same priority, that's a shadowing conflict.
***
*** #3 pack-tool composition mismatch: two rules grant the same
*** capability name with different shape hashes (incompatible
*** return types) — a callsite typed against one cannot trust
*** the other.
*** ============================================================

fmod CAPABILITY-CONFLICT-DETECTOR is
  protecting AI-CONFLICT .

  *** Do two capability sets share a capability name?
  op sharesCapName : CapabilitySet CapabilitySet -> Bool .
  eq sharesCapName(noCap, CS:CapabilitySet) = false .
  eq sharesCapName(cap(N:String, S:String) || CS1:CapabilitySet, CS2:CapabilitySet) =
    containsCap(N:String, CS2:CapabilitySet) or sharesCapName(CS1:CapabilitySet, CS2:CapabilitySet) .

  *** Do two capability sets share a name AND disagree on shape?
  op containsCapDifferentShape : String String CapabilitySet -> Bool .
  eq containsCapDifferentShape(N:String, S:String, noCap) = false .
  eq containsCapDifferentShape(N:String, S:String,
                               cap(N:String, S2:String) || CS:CapabilitySet) =
    not (S:String == S2:String) or
    containsCapDifferentShape(N:String, S:String, CS:CapabilitySet) .
  eq containsCapDifferentShape(N:String, S:String,
                               cap(M:String, S2:String) || CS:CapabilitySet) =
    containsCapDifferentShape(N:String, S:String, CS:CapabilitySet) [owise] .

  op sharesCapNameDifferentShape : CapabilitySet CapabilitySet -> Bool .
  eq sharesCapNameDifferentShape(noCap, CS:CapabilitySet) = false .
  eq sharesCapNameDifferentShape(cap(N:String, S:String) || CS1:CapabilitySet,
                                 CS2:CapabilitySet) =
    containsCapDifferentShape(N:String, S:String, CS2:CapabilitySet)
    or sharesCapNameDifferentShape(CS1:CapabilitySet, CS2:CapabilitySet) .

  op detectCapabilityShadowing : AIRule AIRule -> AIConflictSet .
  eq detectCapabilityShadowing(R1:AIRule, R2:AIRule) =
    if eqTenantId(tenantOf(ruleAgent(R1:AIRule)), tenantOf(ruleAgent(R2:AIRule))) and
       sharesCapName(ruleCapabilityGrants(R1:AIRule), ruleCapabilityGrants(R2:AIRule)) and
       rulePriority(R1:AIRule) == rulePriority(R2:AIRule) and
       not (ruleId(R1:AIRule) == ruleId(R2:AIRule))
    then aiConflict(capabilityShadowing, R1:AIRule, R2:AIRule, "Two rules grant the same capability at equal priority within tenant")
    else noAIConflict
    fi .

  op detectPackToolCompositionMismatch : AIRule AIRule -> AIConflictSet .
  eq detectPackToolCompositionMismatch(R1:AIRule, R2:AIRule) =
    if eqTenantId(tenantOf(ruleAgent(R1:AIRule)), tenantOf(ruleAgent(R2:AIRule))) and
       sharesCapNameDifferentShape(ruleCapabilityGrants(R1:AIRule), ruleCapabilityGrants(R2:AIRule)) and
       not (ruleId(R1:AIRule) == ruleId(R2:AIRule))
    then aiConflict(packToolCompositionMismatch, R1:AIRule, R2:AIRule, "Same capability name with mismatched shape signatures")
    else noAIConflict
    fi .
endfm

*** ============================================================
*** SOVEREIGNTY-DETECTOR: conflict #6
***
*** A rule violates sovereignty if any of its tool invocations
*** routes through a jurisdiction outside the tenant's allowed set.
*** This is a single-rule check (independent of other rules).
*** ============================================================

fmod SOVEREIGNTY-DETECTOR is
  protecting AI-CONFLICT .

  *** Per-invocation jurisdiction check (helper).
  op invocationForbiddenJurisdiction : ToolInvocation JurisdictionSet -> Bool .
  eq invocationForbiddenJurisdiction(invokeTool(N:ToolName, A:ArgMap, C:String, J:Jurisdiction), JS:JurisdictionSet) =
    not inJurisdictionSet(J:Jurisdiction, JS:JurisdictionSet) .
  eq invocationForbiddenJurisdiction(I:ToolInvocation, JS:JurisdictionSet) = false [owise] .

  *** Does an invocation list contain any invocation outside the
  *** allowed jurisdiction set? Two-equation list iteration; the
  *** recursive case calls the per-invocation helper, NOT itself
  *** recursively on a single element (which would loop under
  *** assoc-id matching).
  op listHasForbiddenJurisdiction : ToolInvocationList JurisdictionSet -> Bool .
  eq listHasForbiddenJurisdiction(nilInvocation, JS:JurisdictionSet) = false .
  eq listHasForbiddenJurisdiction(I:ToolInvocation >> IL:ToolInvocationList, JS:JurisdictionSet) =
    invocationForbiddenJurisdiction(I:ToolInvocation, JS:JurisdictionSet)
    or listHasForbiddenJurisdiction(IL:ToolInvocationList, JS:JurisdictionSet) .

  op detectSovereigntyViolation : AIRule JurisdictionSet -> AIConflictSet .
  eq detectSovereigntyViolation(R:AIRule, noJurisdiction) = noAIConflict .
  eq detectSovereigntyViolation(R:AIRule, Allowed:JurisdictionSet) =
    if listHasForbiddenJurisdiction(ruleInvocations(R:AIRule), Allowed:JurisdictionSet)
    then aiConflictSingle(sovereigntyViolation, R:AIRule, "Tool invocation routes through forbidden jurisdiction")
    else noAIConflict
    fi .

  *** Apply detection across a rule set with a tenant-allowed set
  op detectSovereigntyAll : RuleSet JurisdictionSet -> AIConflictSet .
  eq detectSovereigntyAll(emptyRules, JS:JurisdictionSet) = noAIConflict .
  eq detectSovereigntyAll(R:AIRule, JS:JurisdictionSet) = detectSovereigntyViolation(R:AIRule, JS:JurisdictionSet) .
  eq detectSovereigntyAll(R:AIRule ; RS:RuleSet, JS:JurisdictionSet) =
    detectSovereigntyViolation(R:AIRule, JS:JurisdictionSet) ||c|| detectSovereigntyAll(RS:RuleSet, JS:JurisdictionSet) .
endfm

*** ============================================================
*** APPROVAL-GATE-CHECK: conflict #8
***
*** A rule's invocation list bypasses approval if it reaches a
*** high-impact action without passing through a requireApproval
*** gate. "High-impact" is encoded by capability_required ==
*** "high_impact" — the encoder marks invocations that need
*** approval gates with this capability tag.
*** ============================================================

fmod APPROVAL-GATE-CHECK is
  protecting AI-CONFLICT .

  *** Does an invocation list reach a high-impact invocation without
  *** an approval gate occurring before it?
  *** Second arg: have we seen an approval gate yet?
  *** Two recursive cases (one per head shape) + base; assoc-id
  *** decomposition handles single-element lists automatically.
  op bypassesApproval : ToolInvocationList Bool -> Bool .
  eq bypassesApproval(nilInvocation, B:Bool) = false .
  eq bypassesApproval(invokeTool(N:ToolName, A:ArgMap, C:String, J:Jurisdiction) >> IL:ToolInvocationList, B:Bool) =
    if C:String == "high_impact" and not B:Bool
    then true
    else bypassesApproval(IL:ToolInvocationList, B:Bool)
    fi .
  eq bypassesApproval(requireApproval(C:String) >> IL:ToolInvocationList, B:Bool) =
    bypassesApproval(IL:ToolInvocationList, true) .

  op detectApprovalGateBypass : AIRule -> AIConflictSet .
  eq detectApprovalGateBypass(R:AIRule) =
    if bypassesApproval(ruleInvocations(R:AIRule), false)
    then aiConflictSingle(approvalGateBypass, R:AIRule, "High-impact invocation reached without approval gate")
    else noAIConflict
    fi .

  op detectApprovalGateBypassAll : RuleSet -> AIConflictSet .
  eq detectApprovalGateBypassAll(emptyRules) = noAIConflict .
  eq detectApprovalGateBypassAll(R:AIRule) = detectApprovalGateBypass(R:AIRule) .
  eq detectApprovalGateBypassAll(R:AIRule ; RS:RuleSet) =
    detectApprovalGateBypass(R:AIRule) ||c|| detectApprovalGateBypassAll(RS:RuleSet) .
endfm

*** ============================================================
*** AUTHORITY-CHECK: conflict #7
***
*** A rule escalates authority if its capability grants raise the
*** effective authority required to call it above the level of
*** any rule in the call graph that triggers it.
***
*** Pairwise check: if R1's capability grants raise the authority
*** above R2's authority_required AND R1's invocations could
*** trigger R2, then R1 escalates the path through R2.
*** ============================================================

fmod AUTHORITY-CHECK is
  protecting AI-CONFLICT .
  protecting CAPABILITY-CONFLICT-DETECTOR .

  *** Does R1's invocation list grant the capability R2 requires?
  *** (Reuse trigger semantics from iot-rules-style cascade detection.)
  op grantsRequired : AIRule AIRule -> Bool .
  eq grantsRequired(R1:AIRule, R2:AIRule) =
    eqTenantId(tenantOf(ruleAgent(R1:AIRule)), tenantOf(ruleAgent(R2:AIRule))) and
    requiresGrantedCapability(ruleTrigger(R2:AIRule), ruleCapabilityGrants(R1:AIRule)) .

  op detectAuthorityEscalation : AIRule AIRule -> AIConflictSet .
  eq detectAuthorityEscalation(R1:AIRule, R2:AIRule) =
    if grantsRequired(R1:AIRule, R2:AIRule) and
       ruleAuthorityRequired(R1:AIRule) < ruleAuthorityRequired(R2:AIRule) and
       not (ruleId(R1:AIRule) == ruleId(R2:AIRule))
    then aiConflict(authorityEscalation, R1:AIRule, R2:AIRule, "Rule grants capability requiring higher authority than caller")
    else noAIConflict
    fi .
endfm

*** ============================================================
*** CASCADE-DETECTOR: conflict #9 (agent-loop cascade)
***
*** Same shape as iot-rules' state-cascade — one rule's effect
*** triggers another. Lifted to AI: one rule's capability grant
*** satisfies another rule's capability_required predicate.
*** ============================================================

fmod CASCADE-DETECTOR is
  protecting AI-CONFLICT .

  op cascadeFires : AIRule AIRule -> Bool .
  eq cascadeFires(R1:AIRule, R2:AIRule) =
    eqTenantId(tenantOf(ruleAgent(R1:AIRule)), tenantOf(ruleAgent(R2:AIRule))) and
    requiresGrantedCapability(ruleTrigger(R2:AIRule), ruleCapabilityGrants(R1:AIRule)) .

  op detectAgentLoopCascade : AIRule AIRule -> AIConflictSet .
  eq detectAgentLoopCascade(R1:AIRule, R2:AIRule) =
    if cascadeFires(R1:AIRule, R2:AIRule) and
       not (ruleId(R1:AIRule) == ruleId(R2:AIRule))
    then aiConflict(agentLoopCascade, R1:AIRule, R2:AIRule, "Rule grants the capability another rule requires (cascade edge)")
    else noAIConflict
    fi .
endfm

*** ============================================================
*** AI-CONFLICT-DETECTOR: top-level aggregation
*** ============================================================

fmod AI-CONFLICT-DETECTOR is
  protecting TOOL-CONFLICT-DETECTOR .
  protecting CAPABILITY-CONFLICT-DETECTOR .
  protecting SOVEREIGNTY-DETECTOR .
  protecting APPROVAL-GATE-CHECK .
  protecting AUTHORITY-CHECK .
  protecting CASCADE-DETECTOR .

  *** Pairwise conflict detection across all bilateral conflict types
  op detectPairConflicts : AIRule AIRule -> AIConflictSet .
  eq detectPairConflicts(R1:AIRule, R2:AIRule) =
    detectToolCallConflict(R1:AIRule, R2:AIRule) ||c||
    detectCapabilityShadowing(R1:AIRule, R2:AIRule) ||c||
    detectPackToolCompositionMismatch(R1:AIRule, R2:AIRule) ||c||
    detectAuthorityEscalation(R1:AIRule, R2:AIRule) ||c||
    detectAuthorityEscalation(R2:AIRule, R1:AIRule) ||c||
    detectAgentLoopCascade(R1:AIRule, R2:AIRule) ||c||
    detectAgentLoopCascade(R2:AIRule, R1:AIRule) .

  *** Per-rule single-rule detection (sovereignty, approval-gate)
  op detectSingleRuleConflicts : AIRule JurisdictionSet -> AIConflictSet .
  eq detectSingleRuleConflicts(R:AIRule, JS:JurisdictionSet) =
    detectSovereigntyViolation(R:AIRule, JS:JurisdictionSet) ||c||
    detectApprovalGateBypass(R:AIRule) .

  *** Visit each unordered pair once.
  op detectAllPairConflicts : RuleSet -> AIConflictSet .
  op detectPairConflictsWith : AIRule RuleSet -> AIConflictSet .
  eq detectAllPairConflicts(emptyRules) = noAIConflict .
  eq detectAllPairConflicts(R:AIRule ; RS:RuleSet) =
    detectPairConflictsWith(R:AIRule, RS:RuleSet) ||c|| detectAllPairConflicts(RS:RuleSet) .
  eq detectPairConflictsWith(R:AIRule, emptyRules) = noAIConflict .
  eq detectPairConflictsWith(R1:AIRule, R2:AIRule ; RS:RuleSet) =
    detectPairConflicts(R1:AIRule, R2:AIRule) ||c|| detectPairConflictsWith(R1:AIRule, RS:RuleSet) .

  *** All single-rule detection over a rule set against allowed jurisdictions
  op detectAllSingleRuleConflicts : RuleSet JurisdictionSet -> AIConflictSet .
  eq detectAllSingleRuleConflicts(emptyRules, JS:JurisdictionSet) = noAIConflict .
  eq detectAllSingleRuleConflicts(R:AIRule, JS:JurisdictionSet) = detectSingleRuleConflicts(R:AIRule, JS:JurisdictionSet) .
  eq detectAllSingleRuleConflicts(R:AIRule ; RS:RuleSet, JS:JurisdictionSet) =
    detectSingleRuleConflicts(R:AIRule, JS:JurisdictionSet) ||c||
    detectAllSingleRuleConflicts(RS:RuleSet, JS:JurisdictionSet) .

  *** Combined: pairwise + single-rule
  op detectAllConflicts : RuleSet JurisdictionSet -> AIConflictSet .
  eq detectAllConflicts(RS:RuleSet, JS:JurisdictionSet) =
    detectAllPairConflicts(RS:RuleSet) ||c||
    detectAllSingleRuleConflicts(RS:RuleSet, JS:JurisdictionSet) .
endfm
