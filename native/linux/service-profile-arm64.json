{
  "schema_version": 1,
  "profile_id": "debian13-arm64-local-service-v1",
  "distribution": "debian",
  "distribution_version": "13",
  "architecture": "arm64",
  "systemd_minimum_version": 257,
  "account": "wotex-home",
  "group": "wotex-home",
  "unit": "wotex-home.service",
  "release_parent": "/opt/wotex-home/releases",
  "state_directory": "/var/lib/wotex-home",
  "runtime_directory": "/run/wotex-home",
  "socket": "/var/lib/wotex-home/ipc/home.sock",
  "journal_namespace": "wotex-home",
  "journal_mount_directory": "/run/wotexhomejournal",
  "erl_flags": "+S 4:4 +SDcpu 2 +SDio 2",
  "main_limits": {
    "cpu_quota_percent": 200,
    "memory_high_bytes": 402653184,
    "memory_max_bytes": 536870912,
    "memory_swap_max_bytes": 0,
    "tasks_max": 96,
    "nofile": 4096,
    "core_bytes": 0,
    "restart_delay_seconds": 5,
    "start_limit_interval_seconds": 60,
    "start_limit_burst": 3,
    "stop_timeout_seconds": 30
  },
  "journal_limits": {
    "cpu_quota_percent": 50,
    "memory_max_bytes": 100663296,
    "memory_swap_max_bytes": 0,
    "tasks_max": 32,
    "nofile": 4096,
    "tmpfs_bytes": 33554432,
    "retained_bytes": 16777216,
    "file_bytes": 1048576,
    "rate_interval_seconds": 30,
    "rate_burst": 100
  },
  "physical_dispatch": "disabled_by_default",
  "lan_listener": "not_configured",
  "device_access": "none",
  "durable_state_hard_quota": "not_implemented",
  "resource_measurement": "not_qualified",
  "installed_host_qualification": "missing"
}
